{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Spring Boot Metrics",
    "tags": ["spring-boot", "prometheus"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "type": "graph",
        "title": "HTTP Requests per Second",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)",
            "legendFormat": "{{uri}}",
            "interval": ""
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "Response Time (ms)",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "avg(http_server_requests_seconds_sum / http_server_requests_seconds_count) by (uri)",
            "legendFormat": "{{uri}}",
            "interval": ""
          }
        ],
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "JVM Memory Used",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(jvm_memory_used_bytes) by (area)",
            "legendFormat": "{{area}}",
            "interval": ""
          }
        ],
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "JVM GC Count",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(jvm_gc_pause_seconds_count)",
            "legendFormat": "GC Count",
            "interval": ""
          }
        ],
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "Active Threads",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(jvm_threads_live_threads)",
            "legendFormat": "Threads",
            "interval": ""
          }
        ],
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}
      },
      {
        "type": "graph",
        "title": "CPU Usage",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(process_cpu_usage)",
            "legendFormat": "CPU Usage",
            "interval": ""
          }
        ],
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}
      }
    ]
  }
}

