# -----------------------
# Database (produção)
# -----------------------
POSTGRES_HOST=prod-postgres
POSTGRES_PORT=5432
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_password

# Database names / schemas
USER_DB=userdb
PRODUCT_DB=productdb
ORDER_DB=orderdb
KEYCLOAK_DB=keycloak

# -----------------------
# Services ports
# -----------------------
USER_SERVICE_PORT=8083
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8081
API_GATEWAY_PORT=8080
CONFIG_SERVER_PORT=8888

# -----------------------
# Config Server
# -----------------------
# Git remoto com configs de produção
SPRING_CLOUD_CONFIG_GIT_URI=https://github.com/rbnascimentoo/marketplace-configs
SPRING_CLOUD_CONFIG_GIT_LABEL=main

# -----------------------
# Keycloak
# -----------------------
KEYCLOAK_PORT=9090
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# -----------------------
# Redis
# -----------------------
REDIS_PORT=6379

# -----------------------
# Prometheus & Grafana
# -----------------------
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# -----------------------
# PgAdmin
# -----------------------
PGADMIN_PORT=5050

# -----------------------
# Spring profile
# -----------------------
SPRING_PROFILES_ACTIVE=prod

# -----------------------
# Notification channels (exemplo)
# -----------------------
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_PUSH_ENABLED=true